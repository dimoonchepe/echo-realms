---
interface Props {
  activePage?: 'listened' | 'candidates' | 'about';
}
const { activePage } = Astro.props;
---
<nav>
  <a class="nav-logo" href="/">Echo Realms</a>
  <ul class="nav-links">
    <li><a href="/listened" class={activePage === 'listened' ? 'active' : ''}>Listened</a></li>
    <li><a href="/about" class={activePage === 'about' ? 'active' : ''}>About</a></li>
  </ul>
</nav>
