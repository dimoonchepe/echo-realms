---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title="About — Echo Realms" />
  <style>
    body { display: flex; flex-direction: column; min-height: 100vh; }

    .about-bg {
      position: fixed;
      top: 0; right: 0;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, oklch(0.62 0.12 28 / 0.06) 0%, transparent 65%);
      pointer-events: none;
    }

    .about-page { flex: 1; }

    .about-container {
      max-width: 640px;
      margin: 0 auto;
      padding: calc(var(--nav-h) + 72px) 48px 120px;
    }

    .about-eyebrow {
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--text-faint);
      display: block;
      margin-bottom: 32px;
    }

    .about-name {
      font-size: clamp(36px, 5vw, 56px);
      font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--text);
      line-height: 1.1;
      margin-bottom: 8px;
    }
    .about-name em { font-style: normal; color: var(--gold); }

    .about-handle {
      font-size: 14px;
      color: var(--text-faint);
      letter-spacing: 0.1em;
      margin-bottom: 56px;
      display: block;
    }

    .about-divider { height: 1px; background: var(--border); margin: 48px 0; }

    .about-section-label {
      font-size: 10px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--text-faint);
      margin-bottom: 18px;
      display: block;
    }

    .about-body { font-size: 15px; line-height: 1.85; color: var(--text-muted); }
    .about-body p { margin-bottom: 20px; }
    .about-body p:last-child { margin-bottom: 0; }

    .about-links {
      display: flex;
      gap: 20px;
      margin-top: 48px;
      flex-wrap: wrap;
    }
    .about-links a {
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
      border-bottom: 1px solid var(--border-mid);
      padding-bottom: 3px;
      transition: color 0.2s, border-color 0.2s;
    }
    .about-links a:hover { color: var(--gold); border-color: var(--gold-dim); }
  </style>
</head>
<body>
  <Nav activePage="about" />
  <div class="about-bg"></div>

  <main class="about-page">
    <div class="about-container">
      <span class="about-eyebrow">The person behind the ears</span>
      <h1 class="about-name">Dmitry<br><em>Chubarada</em></h1>
      <span class="about-handle">Chubarada</span>

      <div class="about-divider"></div>

      <span class="about-section-label">About this site</span>
      <div class="about-body">
        <p>Echo Realms is a personal music diary built around one idea: an album is not a playlist. It is a single work of art with a beginning, a middle, and an end — and it deserves to be heard that way.</p>
        <p>Each entry here is the record of a full listening experience, met in one sitting without interruption. The portal on the home page opens a random door into the collection — an invitation to encounter something unknown, the way a good record shop used to work.</p>
        <p>The notes on each album are kept behind a fold. They are meant to be read <em style="color:var(--text);">after</em> you've listened — not before. The music comes first.</p>
      </div>

      <div class="about-links">
        <a href="/listened">The Listened</a>
        <a href="/candidates">Candidates</a>
        <a href="/">Enter the portal</a>
      </div>
    </div>
  </main>

  <Footer />
</body>
</html>
