---
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { itunesImage } from '../../utils/itunesImage';

export async function getStaticPaths() {
  const albums = await getCollection('albums');
  return albums.map(album => ({
    params: { slug: album.id },
    props: { album },
  }));
}

const { album } = Astro.props;
const { data } = album;

const isListened = !!(data.listenSessionDate && data.listenSessionDate.trim() !== '');
const status = isListened ? 'listened' : 'to-listen';

const { Content } = await render(album);
const hasNotes = !!(album.body && album.body.trim() !== '');

// Build streaming platforms list
const platforms = [
  { key: 'youtube',    label: 'YouTube Music',  url: data.youtubeMusicURL, dotClass: 'dot-youtube' },
  { key: 'bandcamp',   label: 'Bandcamp',       url: data.bandcampURL,     dotClass: 'dot-bandcamp' },
  { key: 'spotify',    label: 'Spotify',       url: data.spotifyURL,      dotClass: 'dot-spotify' },
  { key: 'deezer',     label: 'Deezer',         url: data.deezerURL,       dotClass: 'dot-deezer' },
  { key: 'apple',      label: 'Apple Music',    url: data.appleMusicURL,   dotClass: 'dot-apple' },
].filter(p => p.url && p.url.trim() !== '');

const backHref  = isListened ? '/listened'  : '/candidates';
const backLabel = isListened ? 'The Listened' : 'Candidates';
const statusColor = isListened ? 'var(--gold)' : 'var(--terra)';
const statusText  = isListened ? 'Listened' : 'Candidate';
const pageTitle = `${data.artist} — ${data.title} · Echo Realms`;
const coverLargeURL = itunesImage(data.coverURL, 600) ?? data.coverURL;
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={pageTitle} />
  <style>
    body { display: flex; flex-direction: column; min-height: 100vh; }

    .album-page {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: calc(100vh - var(--nav-h));
      margin-top: var(--nav-h);
    }

    /* LEFT — art panel */
    .art-panel {
      position: sticky;
      top: var(--nav-h);
      height: calc(100vh - var(--nav-h));
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px;
      overflow: hidden;
    }
    .art-panel-bg {
      position: absolute;
      inset: 0;
      opacity: 0.35;
      filter: blur(60px);
      transform: scale(1.4);
    }
    .art-frame {
      position: relative;
      z-index: 1;
      width: min(380px, 100%);
      aspect-ratio: 1;
      box-shadow:
        0 8px 40px rgba(0,0,0,0.7),
        0 24px 80px rgba(0,0,0,0.5),
        0 0 0 1px rgba(255,255,255,0.05) inset;
      overflow: hidden;
    }
    .art-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .art-frame-fallback {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .art-big-label {
      font-size: 100px;
      font-weight: 700;
      color: rgba(255,255,255,0.1);
      letter-spacing: 0.05em;
      mix-blend-mode: overlay;
      pointer-events: none;
    }

    /* RIGHT — info panel */
    .info-panel {
      padding: 80px 64px 80px 56px;
      display: flex;
      flex-direction: column;
      gap: 40px;
      border-left: 1px solid var(--border);
      overflow-y: auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-faint);
      text-decoration: none;
      transition: color 0.2s;
      margin-bottom: -16px;
    }
    .back-link:hover { color: var(--text-muted); }

    .album-meta { display: flex; flex-direction: column; gap: 12px; }

    .album-status-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-faint);
      border: 1px solid var(--border-mid);
      padding: 4px 12px;
      border-radius: 40px;
      width: fit-content;
    }
    .status-dot { width: 5px; height: 5px; border-radius: 50%; }

    .album-artist {
      font-size: clamp(13px, 1.4vw, 15px);
      font-weight: 400;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--gold);
    }
    .album-title {
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 300;
      letter-spacing: 0.02em;
      line-height: 1.15;
      color: var(--text);
    }
    .album-details {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 13px;
      color: var(--text-faint);
      letter-spacing: 0.06em;
    }
    .album-details .sep {
      width: 3px; height: 3px;
      border-radius: 50%;
      background: var(--text-faint);
      flex-shrink: 0;
    }

    .section-label {
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--text-faint);
      margin-bottom: 14px;
    }

    .not-listened-note {
      padding: 20px 24px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.7;
      font-style: italic;
    }

    .info-divider { height: 1px; background: var(--border); }

    /* dot colors */
    .dot-spotify  { background: #1DB954; }
    .dot-apple    { background: #fc3c44; }
    .dot-youtube  { background: #FF0000; }
    .dot-bandcamp { background: #1da0c3; }
    .dot-deezer   { background: #a238ff; }

    @media (max-width: 800px) {
      .album-page { grid-template-columns: 1fr; }
      .art-panel {
        position: relative; top: 0;
        height: 50vw; min-height: 260px;
        padding: 32px;
      }
      .info-panel {
        padding: 40px 32px 80px;
        border-left: none;
        border-top: 1px solid var(--border);
      }
    }
    @media (max-width: 640px) {
      .art-panel {
        height: 72vw;
        min-height: 220px;
        padding: 20px;
      }
      .info-panel {
        padding: 32px 20px 64px;
        gap: 28px;
      }
      .album-title { font-size: clamp(24px, 7vw, 36px); }
    }
  </style>
</head>
<body>
  <Nav activePage={isListened ? 'listened' : 'candidates'} />

  <div class="album-page">
    <!-- LEFT: Art -->
    <div class="art-panel">
      {coverLargeURL
        ? <>
            <div
              class="art-panel-bg"
              style={`background-image:url(${coverLargeURL});background-size:cover;background-position:center;`}
            ></div>
            <div class="art-frame">
              <img src={coverLargeURL} alt={`${data.artist} — ${data.title}`} />
            </div>
          </>
        : <>
            <div class="art-panel-bg" style="background: linear-gradient(135deg, #1e1e1e 0%, #3a3a3a 50%, #555 100%);"></div>
            <div class="art-frame" style="background: linear-gradient(135deg, #1e1e1e 0%, #3a3a3a 50%, #555 100%);">
              <div class="art-frame-fallback">
                <span class="art-big-label">
                  {data.artist.split(' ').map((w: string) => w[0]).join('').slice(0, 3).toUpperCase()}
                </span>
              </div>
            </div>
          </>
      }
    </div>

    <!-- RIGHT: Info -->
    <div class="info-panel">
      <a class="back-link" href={backHref}>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {backLabel}
      </a>

      <div class="album-meta">
        <div class="album-status-tag">
          <span class="status-dot" style={`background:${statusColor};`}></span>
          {isListened && data.listenSessionDate
            ? `Listened · ${data.listenSessionDate}`
            : statusText}
        </div>
        <p class="album-artist">{data.artist}</p>
        <h1 class="album-title">{data.title}</h1>
        <div class="album-details">
          <span>{data.year}</span>
          {data.genre && <><span class="sep"></span><span>{data.genre}</span></>}
        </div>
      </div>

      {platforms.length > 0 && (
        <>
          <div class="info-divider"></div>
          <div>
            <p class="section-label">Listen on</p>
            <div class="stream-links">
              {platforms.map(p => (
                <a class="stream-btn" href={p.url} target="_blank" rel="noopener">
                  <span class={`dot ${p.dotClass}`}></span>
                  {p.label}
                </a>
              ))}
            </div>
          </div>
        </>
      )}

      {!isListened && (
        <div class="not-listened-note">
          This album is waiting for its evening. Notes will appear here after the listening.
        </div>
      )}

      {isListened && hasNotes && (
        <div>
          <div class="notes-wrapper" id="notes">
            <button class="notes-toggle" id="notes-toggle" aria-expanded="false" aria-controls="notes-body">
              <div class="notes-toggle-left">
                <div class="notes-toggle-icon">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M2 3.5h10M2 7h7M2 10.5h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                </div>
                <div class="notes-toggle-text">
                  <span class="notes-toggle-title">A letter from the listener</span>
                  <span class="notes-toggle-sub">Best opened after you've heard it</span>
                </div>
              </div>
              <svg class="notes-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="notes-body" id="notes-body" role="region" aria-labelledby="notes-toggle">
              <div class="notes-content">
                <Content />
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  <script>
    const notesWrapper = document.getElementById('notes');
    const notesToggle  = document.getElementById('notes-toggle');
    if (notesWrapper && notesToggle) {
      notesToggle.addEventListener('click', function () {
        const open = notesWrapper.classList.toggle('open');
        notesToggle.setAttribute('aria-expanded', String(open));
      });
    }
  </script>
</body>
</html>
