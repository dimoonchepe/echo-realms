---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allAlbums = await getCollection('albums');
const listened = allAlbums.filter(a => a.data.listenSessionDate && a.data.listenSessionDate.trim() !== '');
const candidates = allAlbums.filter(a => !a.data.listenSessionDate || a.data.listenSessionDate.trim() === '');
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <style>
    body { display: flex; flex-direction: column; min-height: 100vh; }

    .hero {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 120px 48px 80px;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -20%; left: 50%;
      transform: translateX(-50%);
      width: 700px; height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, oklch(0.72 0.12 52 / 0.07) 0%, oklch(0.72 0.12 52 / 0.03) 40%, transparent 70%);
      pointer-events: none;
    }

    .site-title {
      font-size: clamp(13px, 1.5vw, 15px);
      font-weight: 400;
      letter-spacing: 0.45em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 28px;
    }
    .hero-heading {
      font-size: clamp(36px, 6vw, 72px);
      font-weight: 300;
      letter-spacing: 0.06em;
      line-height: 1.1;
      color: var(--text);
      margin-bottom: 28px;
      max-width: 640px;
    }
    .hero-sub {
      font-size: 15px;
      color: var(--text-muted);
      max-width: 440px;
      line-height: 1.75;
      font-weight: 300;
      margin-bottom: 72px;
    }

    .portal-wrap {
      position: relative;
      margin-bottom: 72px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
    .portal {
      width: 200px; height: 200px;
      border-radius: 50%;
      border: 1.5px solid oklch(0.72 0.12 52 / 0.6);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      background: none;
      position: relative;
      animation: portalBreath 4s ease-in-out infinite;
      transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .portal:hover {
      transform: scale(1.06);
      animation-play-state: paused;
      box-shadow: 0 0 60px 20px oklch(0.72 0.12 52 / 0.28), 0 0 120px 40px oklch(0.72 0.12 52 / 0.12), inset 0 0 60px oklch(0.72 0.12 52 / 0.06);
    }
    .portal::before {
      content: '';
      position: absolute;
      inset: -10px;
      border-radius: 50%;
      border: 1px dashed oklch(0.72 0.12 52 / 0.2);
      animation: portalRotate 24s linear infinite;
    }
    .portal::after {
      content: '';
      position: absolute;
      inset: 12px;
      border-radius: 50%;
      background: radial-gradient(circle, oklch(0.72 0.12 52 / 0.08) 0%, transparent 70%);
      border: 1px solid oklch(0.72 0.12 52 / 0.15);
    }
    @keyframes portalBreath {
      0%, 100% { box-shadow: 0 0 24px 6px oklch(0.72 0.12 52 / 0.18), 0 0 60px 16px oklch(0.72 0.12 52 / 0.08), inset 0 0 24px oklch(0.72 0.12 52 / 0.04); }
      50%       { box-shadow: 0 0 44px 14px oklch(0.72 0.12 52 / 0.30), 0 0 100px 32px oklch(0.72 0.12 52 / 0.14), inset 0 0 44px oklch(0.72 0.12 52 / 0.08); }
    }
    @keyframes portalRotate {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }
    .portal-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }
    .portal-word {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.38em;
      text-transform: uppercase;
      color: var(--gold);
    }
    .portal-glyph { width: 40px; height: 40px; }
    .portal-hint {
      font-size: 11px;
      color: var(--text-faint);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .collection-links {
      display: flex;
      align-items: center;
      border: 1px solid var(--border-mid);
      border-radius: 4px;
      overflow: hidden;
    }
    .coll-link {
      text-decoration: none;
      padding: 14px 36px;
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
      background: var(--surface);
      transition: background 0.2s, color 0.2s;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .coll-link:hover { background: var(--surface-2); color: var(--text); }
    .coll-sep { width: 1px; height: 48px; background: var(--border-mid); }
    .coll-link-count {
      font-size: 10px;
      color: var(--text-faint);
      background: var(--bg-3);
      padding: 2px 7px;
      border-radius: 20px;
    }
  </style>
</head>
<body>
  <Nav />

  <main class="hero">
    <p class="site-title">Echo Realms</p>
    <h1 class="hero-heading">An album is not a playlist</h1>
    <p class="hero-sub">
      A personal diary of full-album listening experiences — each record met as a single work of art, from first note to last.
    </p>

    <div class="portal-wrap">
      <button class="portal" id="portal-btn" title="Enter a random album">
        <div class="portal-inner">
          <svg class="portal-glyph" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="13" stroke="oklch(0.72 0.12 52 / 0.5)" stroke-width="1"/>
            <circle cx="20" cy="20" r="7"  stroke="oklch(0.72 0.12 52 / 0.35)" stroke-width="1"/>
            <circle cx="20" cy="20" r="2"  fill="oklch(0.72 0.12 52 / 0.6)"/>
          </svg>
          <span class="portal-word">Enter</span>
        </div>
      </button>
      <span class="portal-hint">Opens a random album</span>
    </div>

    <div class="collection-links">
      <a class="coll-link" href="/listened">
        The Listened
        <span class="coll-link-count">{listened.length}</span>
      </a>
      <div class="coll-sep"></div>
      <a class="coll-link" href="/candidates">
        Candidates
        <span class="coll-link-count">{candidates.length}</span>
      </a>
    </div>
  </main>

  <Footer />

  <script define:vars={{ allSlugs: allAlbums.map(a => a.id) }}>
    document.getElementById('portal-btn').addEventListener('click', function () {
      const slug = allSlugs[Math.floor(Math.random() * allSlugs.length)];
      window.location.href = '/albums/' + slug;
    });
  </script>
</body>
</html>

